"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"format_datetime(object."
"scheduled_date_start) or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;"
"\">Técnico asignado</td>\n"
