"        "

#. module: fieldservice_appointment_confirmation
#: model:mail.template,body_html:fieldservice_appointment_confirmation.mail_template_appointment_confirmed
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:"
"#333;\">\n"
"                <p>The customer has <strong>confirmed</strong> the "
"appointment.</p>\n"
"                <ul>\n"
"                    <li>Order: <t t-out=\"object.name or ''\"/></li>\n"
"                    <li>Confirmed on:\n"
"                            <t t-out=\"format_datetime(object."
"appointment_confirmed_date) or ''\"/>\n"
"                        </li>\n"
"                    <li>Scheduled for:\n"
"                            <t t-out=\"format_datetime(object."
"scheduled_date_start) or ''\"/>\n"
"                        </li>\n"
"                    <li>Assigned worker: <t t-out=\"object.person_id.name or "
"''\"/></li>\n"
"                </ul>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:"
"#333;\">\n"
"                <p>El cliente ha <strong>confirmado</strong> la cita.</p>\n"
"                <ul>\n"
"                    <li>Orden: <t t-out=\"object.name or ''\"/></li>\n"
"                    <li>Confirmada el:\n"
"                            <t t-out=\"format_datetime(object."
"appointment_confirmed_date) or ''\"/>\n"
"                        </li>\n"
"                    <li>Programada para:\n"
"                            <t t-out=\"format_datetime(object."
"scheduled_date_start) or ''\"/>\n"
"                        </li>\n"
"                    <li>Técnico asignado: <t t-out=\"object.person_id.name "
"or ''\"/></li>\n"
"                </ul>\n"
"            </div>\n"
"        "

