#. module: fieldservice_appointment_confirmation
#: model:mail.template,body_html:fieldservice_appointment_confirmation.mail_template_appointment_request
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#333;\">\n"
"                <p>Dear <t t-out=\"object.location_id.partner_id.name or ''\"/>,</p>\n"
"                <p>We would like to confirm the details of your upcoming\n"
"                        service appointment. Please review the information below\n"
"                        and let us know whether it works for you.</p>\n"
"                <table style=\"border-collapse:collapse;margin:16px 0;width:100%;max-width:520px;\">\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Order</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"object.name or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Date &amp; time</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"format_datetime(object.scheduled_date_start) or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Estimated duration</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                                <t t-out=\"object.scheduled_duration or 0\"/> h\n"
"                            </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Address</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"object.street or ''\"/>\n"
"                            <t t-out=\"object.city and (', ' + object.city) or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Assigned worker</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"object.person_id.name or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <div style=\"margin:24px 0;\">\n"
"                    <a t-att-href=\"object._get_appointment_url('confirm')\" style=\"background-color:#875A7B;color:#fff;text-decoration:none;padding:12px 22px;border-radius:4px;font-weight:bold;display:inline-block;margin-right:8px;\">Confirm Appointment</a>\n"
"                    <a t-att-href=\"object._get_appointment_url('reschedule')\" style=\"background-color:#E7E9ED;color:#374151;text-decoration:none;padding:12px 22px;border-radius:4px;font-weight:bold;display:inline-block;\">Reschedule</a>\n"
"                </div>\n"
"                <p style=\"color:#888;font-size:12px;\">If the buttons do not work,\n"
"                        please contact us and we will be happy to help.</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: fieldservice_appointment_confirmation
#: model:mail.template,body_html:fieldservice_appointment_confirmation.mail_template_appointment_rescheduled
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#333;\">\n"
"                <p>Dear <t t-out=\"object.location_id.partner_id.name or ''\"/>,</p>\n"
"                <p>Your service appointment has been <strong>rescheduled and\n"
"                        confirmed</strong>. Here are the new details:</p>\n"
"                <table style=\"border-collapse:collapse;margin:16px 0;width:100%;max-width:520px;\">\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Order</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"object.name or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">New date &amp; time</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"format_datetime(object.scheduled_date_start) or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:6px 12px;font-weight:bold;\">Assigned worker</td>\n"
"                        <td style=\"padding:6px 12px;\">\n"
"                            <t t-out=\"object.person_id.name or ''\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <div style=\"margin:24px 0;\">\n"
"                    <a t-att-href=\"object._get_appointment_url('reschedule')\" style=\"background-color:#E7E9ED;color:#374151;text-decoration:none;padding:12px 22px;border-radius:4px;font-weight:bold;display:inline-block;\">Change date again</a>\n"
"                </div>\n"
"                <p style=\"color:#888;font-size:12px;\">If you did not request this\n"
"                        change, please contact us.</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: fieldservice_appointment_confirmation
#: model:mail.template,body_html:fieldservice_appointment_confirmation.mail_template_appointment_confirmed
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#333;\">\n"
"                <p>The customer has <strong>confirmed</strong> the appointment.</p>\n"
"                <ul>\n"
"                    <li>Order: <t t-out=\"object.name or ''\"/></li>\n"
"                    <li>Confirmed on:\n"
"                            <t t-out=\"format_datetime(object.appointment_confirmed_date) or ''\"/>\n"
"                        </li>\n"
"                    <li>Scheduled for:\n"
"                            <t t-out=\"format_datetime(object.scheduled_date_start) or ''\"/>\n"
"                        </li>\n"
"                    <li>Assigned worker: <t t-out=\"object.person_id.name or ''\"/></li>\n"
"                </ul>\n"
"            </div>\n"
"        "
msgstr ""

