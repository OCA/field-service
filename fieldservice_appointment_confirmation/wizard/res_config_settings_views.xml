<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.fsm.appointment.confirmation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Field Service Appointments"
                    string="Field Service Appointments"
                    name="fieldservice_appointment_confirmation"
                    logo="/fieldservice/static/description/icon.png"
                >
                    <block
                        title="Appointment Confirmation"
                        name="fsm_appointment_confirmation_setting"
                    >
                        <setting
                            string="Reschedule Window"
                            help="Days ahead offered to the customer when rescheduling."
                        >
                            <field name="fsm_appointment_reschedule_window_days" />
                            <span class="text-muted">days</span>
                        </setting>
                        <setting
                            string="Reschedule Slot Duration"
                            help="Granularity of the time slots offered when rescheduling."
                        >
                            <field name="fsm_appointment_slot_duration_hours" />
                            <span class="text-muted">hours</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
