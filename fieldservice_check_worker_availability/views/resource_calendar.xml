<odoo>
    <record id="view_resource_calendar_check_worker_availability" model="ir.ui.view">
        <field name="name">resource.resource_calendar.check.worker.availability</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='button_box']/button[@icon='fa-plane']"
                position="attributes"
            >
                <attribute name="groups" />
            </xpath>
        </field>
    </record>
</odoo>
