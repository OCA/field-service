    <record
        id="res_config_settings_view_form_inherit_fsm_availability"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.fsm.availability</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="fieldservice.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='route_setting_container']" position="inside">
                <setting
                    id="fsm_default_operational_days"
                    string="Default Operational Days"
                    help="Default delivery/service days applied across all locations and routes unless overridden."
                >
                    <field
                        name="fsm_default_route_day_ids"
                        widget="many2many_tags"
                        placeholder="Select operational days..."
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
