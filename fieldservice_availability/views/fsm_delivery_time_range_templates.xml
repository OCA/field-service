    <record id="view_fsm_delivery_time_range_tree" model="ir.ui.view">
        <field name="name">fsm.delivery.time.range.tree</field>
        <field name="model">fsm.delivery.time.range</field>
        <field name="arch" type="xml">
            <list name="Delivery Time Ranges">
                <field name="sequence" widget="handle" />
                <field name="name" readonly="1" />
                <field name="start_time" widget="float_time" />
                <field name="end_time" widget="float_time" />
                <field name="is_seasonal" />
                <field name="day_start" optional="show" />
                <field name="month_start" optional="show" />
                <field name="day_end" optional="show" />
                <field name="month_end" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_fsm_delivery_time_range_form" model="ir.ui.view">
        <field name="name">fsm.delivery.time.range.form</field>
        <field name="model">fsm.delivery.time.range</field>
        <field name="arch" type="xml">
            <form string="Delivery Time Range">
                <sheet>
                    <group>
                        <group string="Hours">
                            <field name="start_time" widget="float_time" />
                            <field name="end_time" widget="float_time" />
                        </group>
                        <group string="Seasonal Validity (Recurring)">
                            <field name="month_start" required="month_end" />
                            <field
                                name="day_start"
                                invisible="not month_start"
                                required="month_start"
                            />
                            <field name="month_end" required="month_start" />
                            <field
                                name="day_end"
                                invisible="not month_end"
                                required="month_end"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fsm_delivery_time_range" model="ir.actions.act_window">
        <field name="name">Delivery Time Ranges</field>
        <field name="res_model">fsm.delivery.time.range</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
        Add a Field Service Delivery Time Range here.
      </p>
        </field>
    </record>
</odoo>
