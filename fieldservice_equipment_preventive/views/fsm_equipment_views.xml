<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_equipment_form_view" model="ir.ui.view">
        <field name="name">fsm.equipment.form.preventive</field>
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice.fsm_equipment_form_view" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Preventive Visits" name="preventive">
                    <field name="preventive_ids">
                        <list editable="bottom">
                            <field name="type_id" />
                            <field name="interval" />
                            <field
                                name="template_id"
                                groups="fieldservice.group_fsm_template"
                            />
                            <field name="last_date" />
                            <field name="next_date" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
    <record id="fsm_equipment_search_view" model="ir.ui.view">
        <field name="name">fsm.equipment.search.preventive</field>
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice.fsm_equipment_search_view" />
        <field name="arch" type="xml">
            <search position="inside">
                <filter
                    name="preventive_due"
                    string="Preventive Due"
                    domain="[('next_preventive_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"
                />
            </search>
        </field>
    </record>
</odoo>
