<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_equipment_label" model="report.paperformat">
        <field name="name">Equipment Label 60x40mm</field>
        <field name="format">custom</field>
        <field name="page_height">40</field>
        <field name="page_width">60</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">80</field>
    </record>
    <record id="action_report_equipment_qr_label" model="ir.actions.report">
        <field name="name">Equipment QR Label (PDF)</field>
        <field name="model">fsm.equipment</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >fieldservice_equipment_portal_qrcode.report_equipment_qr_label</field>
        <field
            name="report_file"
        >fieldservice_equipment_portal_qrcode.report_equipment_qr_label</field>
        <field name="paperformat_id" ref="paperformat_equipment_label" />
        <field
            name="print_report_name"
        >'Equipment QR Label - %s' % (object.lot_id.name or object.name)</field>
        <field name="binding_model_id" ref="fieldservice.model_fsm_equipment" />
        <field name="binding_type">report</field>
    </record>
</odoo>
