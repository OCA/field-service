<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_equipment_location_history_view_list" model="ir.ui.view">
        <field name="name">fsm.equipment.location.history.list</field>
        <field name="model">fsm.equipment.location.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="equipment_id" />
                <field name="from_location_id" />
                <field name="to_location_id" />
                <field name="type_selection" />
                <field name="picking_id" />
            </list>
        </field>
    </record>
    <record id="fsm_equipment_location_history_view_form" model="ir.ui.view">
        <field name="name">fsm.equipment.location.history.form</field>
        <field name="model">fsm.equipment.location.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id" />
                            <field name="date" />
                            <field name="type_selection" />
                        </group>
                        <group>
                            <field name="from_location_id" />
                            <field name="to_location_id" />
                            <field name="picking_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_equipment_location_history_action" model="ir.actions.act_window">
        <field name="name">Equipment Location History</field>
        <field name="res_model">fsm.equipment.location.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Transfer an equipment between stock locations.
            </p>
        </field>
    </record>
    <menuitem
        action="fsm_equipment_location_history_action"
        parent="fieldservice.data"
        id="fsm_equipment_location_history_menu"
        sequence="26"
    />
</odoo>
