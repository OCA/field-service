<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_order_form" model="ir.ui.view">
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice_agreement.fsm_order_form" />
        <field name="arch" type="xml">
            <field name="agreement_id" position="after">
                <field
                    name="serviceprofile_id"
                    domain="[('agreement_id', '=', agreement_id)]"
                />
            </field>
        </field>
    </record>

    <record id="fsm_order_search_view" model="ir.ui.view">
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    name="serviceprofile_id"
                    string="Service Profile"
                    domain="[]"
                    context="{'group_by': 'serviceprofile_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
