<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="fsm_equipment_form_view" model="ir.ui.view">
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice_agreement.fsm_equipment_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='agreement_id']" position="after">
                <field
                    name="serviceprofile_id"
                    domain="[('agreement_id', '=', agreement_id)]"
                />
            </xpath>
        </field>
    </record>

    <record id="fsm_equipment_search_view" model="ir.ui.view">
        <field name="model">fsm.equipment</field>
        <field name="inherit_id" ref="fieldservice.fsm_equipment_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    name="serviceprofile_id"
                    string="Service Profile"
                    domain="[]"
                    context="{'group_by': 'serviceprofile_id'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
