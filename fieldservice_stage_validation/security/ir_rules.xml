<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fieldservice_stage_validation_models" model="ir.rule">
        <field name="name">Fieldservice Stage Validation Models</field>
        <field name="model_id" ref="base.model_ir_model" />
        <field
            name="domain_force"
            eval="[('id', 'in', [
                ref('fieldservice.model_fsm_equipment'),
                ref('fieldservice.model_fsm_location'),
                ref('fieldservice.model_fsm_order'),
                ref('fieldservice.model_fsm_person'),
            ])]"
        />
        <field
            name="groups"
            eval="[Command.link(ref('fieldservice.group_fsm_manager'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="fieldservice_stage_validation_fields" model="ir.rule">
        <field name="name">Fieldservice Stage Validation Fields</field>
        <field name="model_id" ref="base.model_ir_model_fields" />
        <field
            name="domain_force"
            eval="[('model_id', 'in', [
                ref('fieldservice.model_fsm_equipment'),
                ref('fieldservice.model_fsm_location'),
                ref('fieldservice.model_fsm_order'),
                ref('fieldservice.model_fsm_person'),
            ])]"
        />
        <field
            name="groups"
            eval="[Command.link(ref('fieldservice.group_fsm_manager'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <!-- These last rules are necessary because with the rules above might inadvertedly
     override the administrator rights. This happens if we assign the administrator to
     the group `fieldservice.group_fsm_manager`-->
    <record id="fieldservice_stage_override_admin_models" model="ir.rule">
        <field name="name">Administrator Models Override</field>
        <field name="model_id" ref="base.model_ir_model" />
        <field name="domain_force" eval="[(1, '=', 1)]" />
        <field name="groups" eval="[Command.link(ref('base.group_erp_manager'))]" />
    </record>
    <record id="fieldservice_stage_override_admin_model_fields" model="ir.rule">
        <field name="name">Administrator Model Fields Override</field>
        <field name="model_id" ref="base.model_ir_model_fields" />
        <field name="domain_force" eval="[(1, '=', 1)]" />
        <field name="groups" eval="[Command.link(ref('base.group_erp_manager'))]" />
    </record>
</odoo>
