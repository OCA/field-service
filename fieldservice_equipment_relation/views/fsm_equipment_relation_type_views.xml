<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_equipment_relation_type_list_view" model="ir.ui.view">
        <field name="name">fsm.equipment.relation.type.list</field>
        <field name="model">fsm.equipment.relation.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="inverse_name" />
                <field name="code" />
                <field name="relation_count" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="fsm_equipment_relation_type_form_view" model="ir.ui.view">
        <field name="name">fsm.equipment.relation.type.form</field>
        <field name="model">fsm.equipment.relation.type</field>
        <field name="arch" type="xml">
            <form string="Equipment Relation Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_relations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-link"
                        >
                            <field
                                name="relation_count"
                                widget="statinfo"
                                string="Relations"
                            />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="inverse_name" />
                        <field name="code" />
                        <field name="sequence" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fsm_equipment_relation_type" model="ir.actions.act_window">
        <field name="name">Equipment Relation Types</field>
        <field name="res_model">fsm.equipment.relation.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
