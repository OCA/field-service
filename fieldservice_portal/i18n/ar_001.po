#. module: fieldservice_portal
#: model:mail.template,body_html:fieldservice_portal.email_installation_completed
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.name\" />,</p>\n"
"    <p>Installation is complete. The installed equipment is ready for use.</p>\n"
"    <p>You can submit future maintenance requests from your account:</p>\n"
"    <p style=\"margin: 16px 0;\">\n"
"        <a t-att-href=\"ctx.get('portal_url', '/my/requests')\" style=\"background-color: #007BFF; color: white; padding: 10px 20px;                   text-decoration: none; border-radius: 5px; font-weight: bold;\">\n"
"            Request Maintenance\n"
"        </a>\n"
"    </p>\n"
"    <p>Thank you for choosing <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>مرحباً <t t-out=\"object.name\" />,</p>\n"
"    <p>اكتمل التركيب بنجاح. المعدات المركبة جاهزة للعمل.</p>\n"
"    <p>للصيانة المستقبلية، يمكنك طلبها من حسابك:</p>\n"
"    <p style=\"margin: 16px 0;\">\n"
"        <a t-att-href=\"ctx.get('portal_url', '/my/requests')\" style=\"background-color: #007BFF; color: white; padding: 10px 20px;                   text-decoration: none; border-radius: 5px; font-weight: bold;\">\n"
"            طلب صيانة\n"
"        </a>\n"
"    </p>\n"
"    <p>شكراً لاختيارك <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"

#. module: fieldservice_portal
#: model:mail.template,body_html:fieldservice_portal.email_maintenance_completed
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.name\" />,</p>\n"
"    <p>The service has been completed successfully. The installed equipment is operating normally.</p>\n"
"    <p>Thank you for choosing <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>مرحباً <t t-out=\"object.name\" />,</p>\n"
"    <p>اكتملت الخدمة بنجاح. المعدات المركبة تعمل الآن بصورة طبيعية.</p>\n"
"    <p>شكراً لاختيارك <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"

#. module: fieldservice_portal
#: model:mail.template,body_html:fieldservice_portal.email_installation_quote
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.name\" />,</p>\n"
"    <p>Your installation quotation is ready.</p>\n"
"    <p>Please visit your portal account to review it and complete payment.</p>\n"
"    <p style=\"margin: 16px 0;\">\n"
"        <a t-att-href=\"ctx.get('portal_url', '/my/orders')\" style=\"background-color: #007BFF; color: white; padding: 10px 20px;                   text-decoration: none; border-radius: 5px; font-weight: bold;\">\n"
"            View Quotation\n"
"        </a>\n"
"    </p>\n"
"    <p>Thank you for choosing <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>مرحباً <t t-out=\"object.name\" />,</p>\n"
"    <p>عرض سعر التركيب جاهز.</p>\n"
"    <p>للاطلاع والدفع، يرجى زيارة حسابك في البوابة.</p>\n"
"    <p style=\"margin: 16px 0;\">\n"
"        <a t-att-href=\"ctx.get('portal_url', '/my/orders')\" style=\"background-color: #007BFF; color: white; padding: 10px 20px;                   text-decoration: none; border-radius: 5px; font-weight: bold;\">\n"
"            عرض السعر\n"
"        </a>\n"
"    </p>\n"
"    <p>شكراً لاختيارك <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"

#. module: fieldservice_portal
#: model:mail.template,body_html:fieldservice_portal.email_installation_paid
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.name\" />,</p>\n"
"    <p>Your payment has been received successfully.</p>\n"
"    <p>Please choose a suitable installation appointment:</p>\n"
"    <p style=\"margin: 16px 0;\">\n"
"        <a t-att-href=\"ctx.get('portal_url', '/my/installation')\" style=\"background-color: #28a745; color: white; padding: 10px 20px;                   text-decoration: none; border-radius: 5px; font-weight: bold;\">\n"
"            Schedule Installation\n"
"        </a>\n"
"    </p>\n"
"    <p>Thank you for choosing <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>مرحباً <t t-out=\"object.name\" />,</p>\n"
"    <p>تم استلام الدفعة بنجاح.</p>\n"
"    <p>يرجى اختيار موعد التركيب المناسب لك:</p>\n"
"    <p style=\"margin: 16px 0;\">\n"
"        <a t-att-href=\"ctx.get('portal_url', '/my/installation')\" style=\"background-color: #28a745; color: white; padding: 10px 20px;                   text-decoration: none; border-radius: 5px; font-weight: bold;\">\n"
"            اختر موعد التركيب\n"
"        </a>\n"
"    </p>\n"
"    <p>شكراً لاختيارك <t t-out=\"object.env.company.name\" />.</p>\n"
"</div>"

#. module: fieldservice_portal
#: model:mail.template,body_html:fieldservice_portal.email_inspection_completed
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"    <p>Hello <t t-out=\"object.name\" />,</p>\n"
"    <p>Your site survey has been completed successfully.</p>\n"
"    <p>We will send your installation quotation shortly.</p>\n"
"    <p>Thank you for choosing <t t-out=\"object.env.company.name\" />.</p>\n"
