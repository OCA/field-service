<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_route_view_form_inherit_portal" model="ir.ui.view">
        <field name="name">fsm.route.view.form.portal</field>
        <field name="model">fsm.route</field>
        <field name="inherit_id" ref="fieldservice_route.fsm_route_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="route_type"/>
            </xpath>
        </field>
    </record>
</odoo>
