<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_type_form_service_type" model="ir.ui.view">
        <field name="name">fsm.order.type.form.service.type</field>
        <field name="model">fsm.order.type</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_type_form_view"/>
        <field name="arch" type="xml">
            <field name="internal_type" position="after">
                <field name="service_type"/>
            </field>
        </field>
    </record>

    <record id="fsm_order_type_list_service_type" model="ir.ui.view">
        <field name="name">fsm.order.type.list.service.type</field>
        <field name="model">fsm.order.type</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_type_list_view"/>
        <field name="arch" type="xml">
            <field name="internal_type" position="after">
                <field name="service_type"/>
            </field>
        </field>
    </record>

    <record id="sale_order_template_form_service_type" model="ir.ui.view">
        <field name="name">sale.order.template.form.service.type</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <field name="mail_template_id" position="after">
                <field name="service_type"/>
            </field>
        </field>
    </record>
</odoo>
