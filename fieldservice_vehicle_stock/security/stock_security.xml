<odoo>
    <!-- The FSM user access rights of this module only cover the transfers
         that load or unload a vehicle. Users who can change transfers through
         another access right (inventory, sales, purchase...) keep it. -->
    <record id="stock_picking_rule_fsm_user_vehicle" model="ir.rule">
        <field name="name">Vehicle transfers: FSM user</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="groups" eval="[(4, ref('fieldservice.group_fsm_user'))]" />
        <field name="domain_force">([(1, '=', 1)]
            if user._fsm_vehicle_stock_unrestricted('stock.picking')
            else [
                '|',
                ('picking_type_id.fsm_vehicle_in', '=', True),
                ('picking_type_id.fsm_vehicle_out', '=', True),
            ])</field>
        <field name="perm_read" eval="False" />
    </record>
    <record id="stock_move_rule_fsm_user_vehicle" model="ir.rule">
        <field name="name">Vehicle stock moves: FSM user</field>
        <field name="model_id" ref="stock.model_stock_move" />
        <field name="groups" eval="[(4, ref('fieldservice.group_fsm_user'))]" />
        <field name="domain_force">([(1, '=', 1)]
            if user._fsm_vehicle_stock_unrestricted('stock.move')
            else [
                '|',
                ('picking_type_id.fsm_vehicle_in', '=', True),
                ('picking_type_id.fsm_vehicle_out', '=', True),
            ])</field>
        <field name="perm_read" eval="False" />
    </record>
</odoo>
