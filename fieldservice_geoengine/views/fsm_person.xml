<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fsm_person_form_geolocation" model="ir.ui.view">
        <field name="name">fsm.person.form.geolocation</field>
        <field name="model">fsm.person</field>
        <field name="inherit_id" ref="fieldservice.fsm_person_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/label" position="before">
                <field name="partner_latitude" invisible="1" />
                <field name="partner_longitude" invisible="1" />
                <div
                    class="alert alert-warning text-center"
                    role="alert"
                    invisible="(partner_latitude != 0) or (partner_longitude != 0)"
                    style="margin-bottom:0px;"
                >
                    <p
                        class="fa fa-warning"
                    >&amp;nbsp;Update Latitude and Longitude details accordingly!</p>
                </div>
            </xpath>
            <xpath expr="//field[@name='calendar_id']" position="before">
                <field name="preferred_route_id" />
            </xpath>
            <xpath expr="//page[field[@name='location_ids']]" position="attributes">
                <attribute name="string">Preferred Locations</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Map" name="geo_location">
                    <group id="get_locate">
                        <field name="shape" />
                        <group string="Geolocation">
                            <label for="date_localization" string="Geo Location" />
                            <div>
                                <span>Lat: <field
                                    name="partner_latitude"
                                    nolabel="1"
                                    class="oe_inline"
                                /></span>
                                <br />
                                <span>Long: <field
                                    name="partner_longitude"
                                    nolabel="1"
                                    class="oe_inline"
                                /></span>
                                <br />
                                <span invisible="not date_localization">Updated on:
                                    <field
                                    name="date_localization"
                                    nolabel="1"
                                    readonly="1"
                                    class="oe_inline"
                                />
                                    <br />
                                </span>
                                <button
                                    invisible="(partner_latitude != 0) or (partner_longitude != 0)"
                                    icon="fa-gear"
                                    string="Compute based on address"
                                    title="Compute Localization"
                                    name="geo_localize"
                                    type="object"
                                    class="btn btn-link p-0"
                                />
                                <button
                                    invisible="partner_latitude == partner_longitude == 0"
                                    icon="fa-refresh"
                                    string="Refresh"
                                    title="Refresh Localization"
                                    name="geo_localize"
                                    type="object"
                                    class="btn btn-link p-0"
                                />
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="fsm_person_kanban_view" model="ir.ui.view">
        <field name="name">fsm.person.kanban</field>
        <field name="model">fsm.person</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="name" />
                <field name="phone" />
                <field name="email" />
                <field name="team_id" />
                <field name="stage_id" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="d-flex">
                                <field
                                    name="image_128"
                                    widget="image"
                                    options="{'img_class': 'o_image_64_cover rounded', 'size': [64, 64]}"
                                />
                                <div class="ms-2">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                    <div>
                                        <field
                                            name="team_id"
                                            groups="fieldservice.group_fsm_team"
                                        />
                                    </div>
                                    <div>
                                        <field name="phone" />
                                    </div>
                                    <div>
                                        <field name="email" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="fieldservice.action_fsm_person" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,geoengine</field>
    </record>
    <record id="ir_ui_view_fsm_person_map" model="ir.ui.view">
        <field name="name">ir.ui.view.fsm.person.map</field>
        <field name="model">fsm.person</field>
        <field name="priority" eval="16" />
        <field name="arch" type="xml">
            <geoengine>
                <field name="display_name" />
                <field name="name" />
                <field name="phone" />
                <field name="email" />
                <field name="street" />
                <field name="street2" />
                <field name="city" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="zip" />
                <field name="stage_name" />
                <field name="shape" />
                <field name="custom_color" />
                <templates>
                    <t t-name="info_box">
                        <b>
                            Name: <field name="name" widget="badge" />
                        </b>
                        <ul>
                            <t t-if="record.phone.value">
                                <li>Phone: <field name="phone" />
                                </li>
                            </t>
                            <t t-if="record.email.value">
                                <li>Email: <field name="email" />
                                </li>
                            </t>
                            <t t-if="record.city.value">
                                <li>City: <field name="city" />
                                </li>
                            </t>
                        </ul>
                    </t>
                </templates>
            </geoengine>
        </field>
    </record>
    <record id="person_geoengine_vector_layer" model="geoengine.vector.layer">
        <field
            name="geo_field_id"
            ref="fieldservice_geoengine.field_fsm_person__shape"
        />
        <field name="name">FSM Worker</field>
        <field name="classification">unique</field>
        <field name="sequence" eval="6" />
        <field name="view_id" ref="ir_ui_view_fsm_person_map" />
        <field name="geo_repr">colored</field>
        <field name="active_on_startup">True</field>
        <field
            name="attribute_field_id"
            ref="fieldservice_geoengine.field_fsm_person__stage_name"
        />
        <field name="begin_color">#1A56DB</field>
    </record>
    <record id="person_geoengine_vector_layer_color" model="geoengine.vector.layer">
        <field
            name="geo_field_id"
            ref="fieldservice_geoengine.field_fsm_person__shape"
        />
        <field name="name">FSM Worker Stage</field>
        <field name="classification">custom</field>
        <field name="sequence" eval="6" />
        <field name="view_id" ref="ir_ui_view_fsm_person_map" />
        <field name="geo_repr">colored</field>
        <field name="nb_class" eval="1" />
        <field
            name="attribute_field_id"
            ref="fieldservice_geoengine.field_fsm_person__custom_color"
        />
        <field name="begin_color">#FFFFFF</field>
    </record>
    <record id="person_geoengine_raster_layer_osm" model="geoengine.raster.layer">
        <field name="raster_type">osm</field>
        <field name="name">Open Street Map</field>
        <field name="view_id" ref="ir_ui_view_fsm_person_map" />
        <field name="overlay" eval="0" />
    </record>
</odoo>
