<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="fsm_recurring_form_sale_timesheet_material" model="ir.ui.view">
        <field name="name">fsm.recurring.form.sale.timesheet.material</field>
        <field name="model">fsm.recurring</field>
        <field name="inherit_id" ref="fieldservice_recurring.fsm_recurring_form_view" />
        <field name="arch" type="xml">
            <button name="action_suspend" position="after">
                <button
                    name="action_create_sale_lines"
                    string="Add to Sale Order"
                    type="object"
                    groups="sales_team.group_sale_salesman"
                    attrs="{'invisible': ['|', ('sale_line_id', '=', False), ('state', '=', 'draft')]}"
                    help="Add the timesheets and consumed materials recorded on the orders of this recurring order as lines on the sale order that sold it."
                />
            </button>
        </field>
    </record>

</odoo>
