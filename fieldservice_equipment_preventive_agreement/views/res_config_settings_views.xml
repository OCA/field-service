<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.preventive.agreement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="fieldservice.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="equipments_setting_container" position="inside">
                <setting
                    string="Require Agreement on Preventive Visits"
                    help="Preventive visits cannot be saved without an agreement"
                    company_dependent="1"
                >
                    <field name="preventive_agreement_required" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
