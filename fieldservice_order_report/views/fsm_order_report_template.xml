<odoo>

    <record id="fsm_order_report_template_tree" model="ir.ui.view">
        <field name="name">Field Service Order Template Tree</field>
        <field name="model">fsm.order.report.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="location_id" />
                <field name="person_id" />
                <field name="team_id" />
                <field name="stage_id" />
                <field name="vehicle_id" />
                <field name="category_ids" widget="many2many_tags" />
                <field name="tag_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>
    <record id="fsm_order_report_template_form" model="ir.ui.view">
        <field name="name">Field Service Report Template</field>
        <field name="model">fsm.order.report.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                                <field name="vehicle_id" />
                                <field name="dayroute_id" />
                                <field name="fsm_route_id" />
                                <field name="person_id" />
                                <field name="location_id" />
                        </group>
                        <group>
                                <field name="stage_id" />
                                <field name="tag_ids" widget="many2many_tags" />
                                <field name="team_id" />
                                <field name="category_ids" widget="many2many_tags" />
                                <field name="type" />
                        </group>
                        <separator string="Report Fields" />
                        <field name="field_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fsm_order_report_template_action" model="ir.actions.act_window">
        <field name="name">Field Service Order Report Template</field>
        <field name="res_model">fsm.order.report.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="fsm_order_report_template_tree" />
    </record>
    <menuitem
        id="fsm_order_report_template_menu_action"
        action="fsm_order_report_template_action"
        parent="fieldservice.menu_fsm_config_order"
    />
</odoo>
