<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_template_form_view_inherit_stock_picking" model="ir.ui.view">
        <field name="name">fsm.template.form.stock.picking</field>
        <field name="model">fsm.template</field>
        <field name="inherit_id" ref="fieldservice.fsm_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_id']" position="after">
                <field name="outgoing_picking_type_id" options="{'no_create': True}" />
                <field name="incoming_picking_type_id" options="{'no_create': True}" />
            </xpath>
        </field>
    </record>
</odoo>
