<odoo>
    <template
        id="report_fsm_order_document_timesheet_material"
        inherit_id="fieldservice.report_fsm_order_document"
    >
        <xpath expr="//div[@id='resolution']" position="after">
            <!-- Time spent -->
            <div t-if="doc.timesheet_ids" id="fsm_timesheets" class="mt-4">
                <h3>Time Spent</h3>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Worker</th>
                            <th>Time Type</th>
                            <th>Description</th>
                            <th class="text-end">Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="doc.timesheet_ids.sorted(key=lambda t: t.date or '')"
                            t-as="line"
                        >
                            <td><span t-field="line.date" /></td>
                            <td><span t-field="line.user_id" /></td>
                            <td><span t-field="line.product_id" /></td>
                            <td><span t-field="line.name" /></td>
                            <td class="text-end">
                                <span
                                    t-field="line.unit_amount"
                                    t-options='{"widget": "float_time"}'
                                />
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end"><strong>Total</strong></td>
                            <td class="text-end">
                                <strong>
                                    <span
                                        t-out="sum(doc.timesheet_ids.mapped('unit_amount'))"
                                        t-options='{"widget": "float_time"}'
                                    />
                                </strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- Materials used and returned -->
            <t t-set="material_lines" t-value="doc._report_material_lines()" />
            <div t-if="material_lines" id="fsm_materials" class="mt-4">
                <h3>Materials</h3>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Direction</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit of Measure</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="material_lines" t-as="material">
                            <td><span t-esc="material['product'].display_name" /></td>
                            <td>
                                <span t-if="material['direction'] == 'out'">Used</span>
                                <span t-else="">Returned</span>
                            </td>
                            <td class="text-end">
                                <span
                                    t-esc="material['qty']"
                                    t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'
                                />
                            </td>
                            <td><span t-esc="material['uom'].name" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
