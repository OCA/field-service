<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fsm_order_form_sale_timesheet_material" model="ir.ui.view">
        <field name="name">fsm.order.form.sale.timesheet.material</field>
        <field name="model">fsm.order</field>
        <field
            name="inherit_id"
            ref="fieldservice_timesheet.view_fsm_order_project_form"
        />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_create_sale_lines"
                    string="Add to Sale Order"
                    type="object"
                    class="oe_highlight"
                    groups="sales_team.group_sale_salesman"
                    invisible="not sale_id"
                    help="Add the recorded timesheets and consumed materials as lines on the order's sale order."
                />
            </header>
            <field name="timesheet_ids" position="inside">
                <list editable="bottom" default_order="date">
                    <field name="date" />
                    <field name="user_id" />
                    <field
                        name="product_id"
                        string="Time Type"
                        domain="[('type', '=', 'service')]"
                    />
                    <field name="name" />
                    <field name="unit_amount" string="Duration" widget="float_time" />
                    <field name="company_id" column_invisible="1" />
                    <!-- keep the order's project and task given by the context -->
                    <field name="project_id" column_invisible="1" />
                    <field name="task_id" column_invisible="1" />
                    <field name="fsm_sale_line_id" readonly="1" optional="hide" />
                </list>
            </field>
        </field>
    </record>
</odoo>
