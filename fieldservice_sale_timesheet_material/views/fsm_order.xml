<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="fsm_order_form_sale_timesheet_material" model="ir.ui.view">
        <field name="name">fsm.order.form.sale.timesheet.material</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_create_sale_lines"
                    string="Add to Sale Order"
                    type="object"
                    class="oe_highlight"
                    groups="sales_team.group_sale_salesman"
                    attrs="{'invisible': [('sale_id', '=', False)]}"
                    help="Add the recorded timesheets and consumed materials as lines on the order's sale order."
                />
            </header>
            <xpath expr="//notebook/page[@name='planning_page']" position="after">
                <page string="Timesheets" name="fsm_timesheet_page">
                    <field name="timesheet_ids">
                        <tree editable="bottom" default_order="date">
                            <field name="date" />
                            <field name="user_id" />
                            <field
                                name="product_id"
                                string="Time Type"
                                domain="[('type', '=', 'service')]"
                            />
                            <field name="name" />
                            <field
                                name="unit_amount"
                                string="Duration"
                                widget="float_time"
                            />
                            <field name="company_id" invisible="1" />
                            <field name="account_id" invisible="1" />
                            <field
                                name="fsm_sale_line_id"
                                readonly="1"
                                optional="hide"
                            />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
