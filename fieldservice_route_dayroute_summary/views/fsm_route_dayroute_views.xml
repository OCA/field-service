<odoo>
    <record id="fsm_route_dayroute_form" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.form - load sheet</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="inherit_id" ref="fieldservice_route.fsm_route_dayroute_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(action_report_dayroute_load_sheet)d"
                    type="action"
                    string="Print Load Sheet"
                    icon="fa-print"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Product Totals" name="product_totals">
                    <field name="summary_line_ids" nolabel="1">
                        <list
                            create="false"
                            delete="false"
                            edit="false"
                            decoration-danger="reserved_quantity &lt; quantity"
                        >
                            <field name="product_id" />
                            <field name="quantity" />
                            <field name="reserved_quantity" column_invisible="True" />
                            <field name="uom_id" string="Unit" />
                            <field name="weight" />
                        </list>
                        <kanban create="false" class="o_kanban_mobile">
                            <field name="reserved_quantity" />
                            <templates>
                                <t t-name="card">
                                    <div
                                        class="d-flex justify-content-between align-items-start gap-2"
                                    >
                                        <field name="product_id" class="fw-bold" />
                                        <span
                                            t-attf-class="badge rounded-pill text-nowrap flex-shrink-0 #{record.reserved_quantity.raw_value &lt; record.quantity.raw_value ? 'text-bg-danger' : 'text-bg-primary'}"
                                        >
                                            <field name="quantity" />
                                            <field name="uom_id" class="ms-1" />
                                        </span>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="weight" />
                                        <field name="weight_uom_name" class="ms-1" />
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <div class="text-end fw-bold mt-2">
                        <span>Total Weight: </span>
                        <field name="total_weight" class="oe_inline" />
                        <field name="weight_uom_name" class="oe_inline ms-1" />
                    </div>
                </page>
                <page string="Delivery Breakdown" name="delivery_breakdown">
                    <field name="location_breakdown_html" nolabel="1" readonly="1" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
