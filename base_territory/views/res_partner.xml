<odoo>
    <record id="view_partner_form_territory" model="ir.ui.view">
        <field name="name">res.partner.form.territory</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('o_address_format')]/field[@name='street2']"
                position="after"
            >
                <field name="district_id" placeholder="District" />
            </xpath>
            <xpath
                expr="//div[hasclass('o_address_format')]/field[@name='city']"
                position="after"
            >
                <field name="region_id" placeholder="Region" />
            </xpath>
            <xpath
                expr="//div[hasclass('o_address_format')]/field[@name='zip']"
                position="after"
            >
                <field name="state_id" position="move" />
            </xpath>
        </field>
    </record>
</odoo>
